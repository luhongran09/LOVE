# Variables must be exported in your shell; this file is documentation, not auto-loaded.
LISTEN_ADDR=127.0.0.1:8080
DATA_DIR=./data
# Set true when accessed over HTTPS.
COOKIE_SECURE=false
# Optional exact browser origin when behind a proxy, e.g. https://album.example.com
APP_ORIGIN=
# ZIP compressed and expanded payload limit; 1..8192 MB. Both export and restore use it.
BACKUP_MAX_MB=250
# Optional OpenAI-compatible story model. Leave key empty to use local story drafts.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# Street/place lookup uses the public Nominatim API only on explicit user action.
# Keep WGS84 coordinates; this version does not convert to GCJ-02/BD-09.
