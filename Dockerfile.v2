FROM node:22-alpine AS web
WORKDIR /build
COPY web/package*.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM golang:1.24-bookworm AS server
WORKDIR /build
COPY server/go.mod server/go.sum ./
RUN go mod download
COPY server/ ./
RUN CGO_ENABLED=1 go build -trimpath -o /footprint .

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/* && useradd --uid 10001 --create-home album
WORKDIR /app/server
COPY --from=server /footprint /app/server/footprint
COPY --from=web /build/dist /app/web/dist
RUN mkdir -p /app/server/data && chown -R album:album /app/server/data
USER album
ENV LISTEN_ADDR=0.0.0.0:8080 DATA_DIR=/app/server/data GIN_MODE=release
EXPOSE 8080
CMD ["./footprint"]
